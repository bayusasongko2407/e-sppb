models:
    Plant: { code: 'string:20 unique', name: 'string:150', description: 'text nullable', is_active: 'boolean default:true index', relationships: { hasMany: 'Department, Location, User, Asset, WorkflowTemplate, WorkflowDelegation, SppbHeader, RunningNumber' } }
    Department: { plant_id: 'id foreign restrictOnDelete', code: 'string:20', name: 'string:150', description: 'text nullable', is_active: 'boolean default:true index', indexes: [{ unique: 'plant_id, code' }, { index: 'plant_id, is_active' }], relationships: { belongsTo: Plant, hasMany: 'User, WorkflowTemplate, SppbHeader' } }
    Location: { plant_id: 'id foreign restrictOnDelete', code: 'string:20', name: 'string:150 index', address: 'text nullable', description: 'text nullable', is_active: 'boolean default:true index', indexes: [{ unique: 'plant_id, code' }, { index: 'plant_id, is_active' }], relationships: { belongsTo: Plant, hasMany: Asset } }
    Unit: { code: 'string:20 unique', name: 'string:100', category: 'string:50 nullable', is_active: 'boolean default:true index', relationships: { hasMany: 'Item, SppbDetail' } }
    Position: { code: 'string:30 unique', name: 'string:100', description: 'text nullable', is_active: 'boolean default:true index', relationships: { hasMany: 'UserPosition, WorkflowStep' } }
    User: { plant_id: 'id nullable foreign restrictOnDelete', department_id: 'id nullable foreign restrictOnDelete', manager_id: 'id nullable foreign restrictOnDelete', nik: 'string:30 unique', name: 'string:150', email: 'string:191 nullable unique', email_verified_at: 'timestamp nullable', password: string, remember_token: rememberToken, is_active: 'boolean default:true index', last_login_at: 'timestamp nullable', failed_login_attempts: 'unsignedInteger default:0', locked_until: 'timestamp nullable', indexes: [{ index: 'plant_id, department_id, is_active' }, { index: manager_id }], relationships: { belongsTo: 'Plant, Department, User:manager', hasMany: 'UserPosition, User:subordinates, WorkflowStepApprover, WorkflowDelegation:delegationsGiven, WorkflowDelegation:delegationsReceived, SppbHeader:requests, Attachment:uploads, Notification, ActivityLog' } }
    UserPosition: { user_id: 'id foreign cascadeOnDelete', position_id: 'id foreign restrictOnDelete', is_primary: 'boolean default:false index', is_active: 'boolean default:true index', valid_from: 'timestamp nullable', valid_until: 'timestamp nullable', indexes: [{ unique: 'user_id, position_id' }, { index: 'position_id, is_active' }], relationships: { belongsTo: 'User, Position' } }
    Item: { code: 'string:30 unique', name: 'string:200', specification: 'text nullable', unit_id: 'id foreign restrictOnDelete', item_category: 'string:50 nullable index', is_active: 'boolean default:true index', indexes: [{ index: 'item_category, is_active' }], relationships: { belongsTo: Unit, hasMany: SppbDetail } }
    Asset: { plant_id: 'id nullable foreign restrictOnDelete', location_id: 'id nullable foreign restrictOnDelete', asset_location_name: 'string:255 nullable', asset_location_address: 'text nullable', barcode: 'string:100 unique', condition: 'string:20 default:GOOD index', status: 'string:20 default:AVAILABLE index', notes: 'text nullable', is_active: 'boolean default:true index', indexes: [{ index: 'plant_id, location_id, status, is_active' }], relationships: { belongsTo: 'Plant, Location', hasMany: SppbDetail } }
    WorkflowTemplate: { uuid: 'uuid unique', code: 'string:30', name: 'string:150', version: 'unsignedInteger default:1', plant_id: 'id nullable foreign restrictOnDelete', department_id: 'id nullable foreign restrictOnDelete', document_type: 'string:30 default:SPPB', description: 'text nullable', is_active: 'boolean default:true index', effective_from: 'timestamp nullable', effective_until: 'timestamp nullable', indexes: [{ unique: 'code, version' }, { index: 'document_type, plant_id, department_id, is_active' }], relationships: { belongsTo: 'Plant, Department', hasMany: 'WorkflowStep, WorkflowInstance' } }
    WorkflowStep: { workflow_template_id: 'id foreign cascadeOnDelete', sequence: unsignedInteger, code: 'string:30', name: 'string:150', approver_type: 'string:30', approver_user_id: 'id nullable foreign restrictOnDelete', approver_position_id: 'id nullable foreign restrictOnDelete', approver_role: 'string:100 nullable', approval_mode: 'string:20 default:ANY', minimum_approvals: 'unsignedInteger default:1', sla_hours: 'unsignedInteger nullable', allow_self_approval: 'boolean default:false', is_final: 'boolean default:false', configuration: 'json nullable', indexes: [{ unique: 'workflow_template_id, sequence' }, { unique: 'workflow_template_id, code' }, { index: approver_position_id }, { index: approver_user_id }], relationships: { belongsTo: 'WorkflowTemplate, User:approverUser, Position:approverPosition', hasMany: WorkflowInstanceStep } }
    WorkflowDelegation: { delegator_id: 'id foreign restrictOnDelete', delegate_id: 'id foreign restrictOnDelete', plant_id: 'id nullable foreign restrictOnDelete', starts_at: timestamp, ends_at: timestamp, reason: text, is_active: 'boolean default:true', indexes: [{ index: 'delegator_id, starts_at, ends_at, is_active' }, { index: 'delegate_id, starts_at, ends_at, is_active' }], relationships: { belongsTo: 'User:delegator, User:delegate, Plant' } }
    SppbHeader: { uuid: 'uuid unique', document_number: 'string:50 nullable unique', plant_id: 'id foreign restrictOnDelete', department_id: 'id foreign restrictOnDelete', requester_id: 'id foreign restrictOnDelete', origin_location_id: 'id foreign restrictOnDelete', destination_location_id: 'id foreign restrictOnDelete', needed_name: 'string:255 nullable', legacy_fppb_hash: 'char:64 nullable', legacy_sj_number: 'string:50 nullable', request_date: date, date_needed: 'date nullable', purpose: longText, is_urgent: 'boolean default:false index', status: 'string:30 default:DRAFT index', revision_no: 'unsignedInteger default:0', current_workflow_instance_id: 'id nullable foreign restrictOnDelete', current_step_sequence: 'unsignedInteger nullable', current_approver_id: 'id nullable foreign restrictOnDelete', lock_version: 'unsignedInteger default:0', submitted_at: 'timestamp nullable', approved_at: 'timestamp nullable', rejected_at: 'timestamp nullable', cancelled_at: 'timestamp nullable', completed_at: 'timestamp nullable', rejected_reason: 'longText nullable', cancelled_reason: 'longText nullable', softdeletes: softDeletes, indexes: [{ index: 'requester_id, status, created_at' }, { index: 'department_id, status, created_at' }, { index: 'plant_id, status, date_needed' }, { index: current_approver_id }], relationships: { belongsTo: 'Plant, Department, User:requester, Location:originLocation, Location:destinationLocation, User:currentApprover, WorkflowInstance:currentWorkflowInstance', hasMany: 'SppbDetail, WorkflowInstance, SppbStatusLog, Attachment, GoodsRelease' } }
    SppbDetail: { sppb_header_id: 'id foreign cascadeOnDelete', line_no: unsignedInteger, barcode_confirmed: 'boolean default:false', item_id: 'id nullable foreign restrictOnDelete', asset_id: 'id nullable foreign restrictOnDelete', reference_code: 'string:100 nullable index', is_from_master: 'boolean default:false', item_asset_name: 'string:200', unit_id: 'id foreign restrictOnDelete', quantity: 'decimal:18,2', remarks: 'longText nullable', delivery_status: 'string:20 nullable index', indexes: [{ unique: 'sppb_header_id, line_no' }, { index: item_id }, { index: asset_id }, { index: unit_id }], relationships: { belongsTo: 'SppbHeader, Item, Asset, Unit', hasMany: GoodsReleaseItem } }
    WorkflowInstance: { uuid: 'uuid unique', workflow_template_id: 'id foreign cascadeOnDelete', sppb_header_id: 'id foreign cascadeOnDelete', template_version: unsignedInteger, revision_no: 'unsignedInteger default:0', status: 'string:30 default:QUEUED index', current_sequence: 'unsignedInteger nullable', started_at: 'timestamp nullable', finished_at: 'timestamp nullable', failure_code: 'string:50 nullable', failure_message: 'text nullable', indexes: [{ unique: 'sppb_header_id, revision_no' }, { index: 'status, current_sequence' }], relationships: { belongsTo: 'WorkflowTemplate, SppbHeader', hasMany: 'WorkflowInstanceStep, SppbStatusLog' } }
    WorkflowInstanceStep: { workflow_instance_id: 'id foreign cascadeOnDelete', workflow_step_id: 'id nullable foreign restrictOnDelete', sequence: unsignedInteger, code: 'string:30', name: 'string:150', approver_type: 'string:30', approval_mode: 'string:20 default:ANY', minimum_approvals: 'unsignedInteger default:1', sla_hours: 'unsignedInteger nullable', status: 'string:30 default:QUEUED index', activated_at: 'timestamp nullable', due_at: 'timestamp nullable index', acted_at: 'timestamp nullable', acted_by_id: 'id nullable foreign restrictOnDelete', remarks: 'text nullable', lock_version: 'unsignedInteger default:0', indexes: [{ unique: 'workflow_instance_id, sequence' }, { index: 'status, due_at' }], relationships: { belongsTo: 'WorkflowInstance, WorkflowStep, User:actedBy', hasMany: 'WorkflowStepApprover, SppbStatusLog' } }
    WorkflowStepApprover: { workflow_instance_step_id: 'id foreign cascadeOnDelete', approver_id: 'id foreign restrictOnDelete', delegated_from_id: 'id nullable foreign restrictOnDelete', status: 'string:20 default:QUEUED index', acted_at: 'timestamp nullable', remarks: 'text nullable', indexes: [{ unique: 'workflow_instance_step_id, approver_id' }, { index: 'approver_id, status' }], relationships: { belongsTo: 'WorkflowInstanceStep, User:approver, User:delegatedFrom' } }
    WorkflowCommand: { command_uuid: 'uuid unique', command_type: 'string:50', aggregate_type: 'string:100', aggregate_id: unsignedBigInteger, actor_id: 'id foreign restrictOnDelete', payload: 'json nullable', status: 'string:20 default:QUEUED index', attempts: 'unsignedInteger default:0', processed_at: 'timestamp nullable', error_code: 'string:50 nullable', error_message: 'text nullable', indexes: [{ index: 'aggregate_type, aggregate_id, status' }, { index: 'actor_id, created_at' }], relationships: { belongsTo: 'User:actor' } }
    SppbStatusLog: { sppb_header_id: 'id foreign cascadeOnDelete', workflow_instance_id: 'id nullable foreign cascadeOnDelete', workflow_instance_step_id: 'id nullable foreign cascadeOnDelete', actor_id: 'id nullable foreign restrictOnDelete', command_uuid: 'uuid nullable', action: 'string:40 index', from_status: 'string:30 nullable', to_status: 'string:30', remarks: 'text nullable', metadata: 'json nullable', correlation_id: 'uuid nullable index', logged_at: 'timestamp index', indexes: [{ index: 'sppb_header_id, logged_at' }, { index: 'command_uuid, action' }], relationships: { belongsTo: 'SppbHeader, WorkflowInstance, WorkflowInstanceStep, User:actor' } }
    Attachment: { uuid: 'uuid unique', sppb_header_id: 'id foreign cascadeOnDelete', original_name: 'string:255', stored_name: 'string:255 unique', disk: 'string:50 default:private', directory: 'string:255', path: 'string:500', mime_type: 'string:100', extension: 'string:20', file_size: unsignedBigInteger, checksum_sha256: 'char:64 index', uploader_id: 'id foreign restrictOnDelete', scan_status: 'string:20 default:PENDING index', softdeletes: softDeletes, indexes: [{ index: 'sppb_header_id, created_at' }, { index: uploader_id }], relationships: { belongsTo: 'SppbHeader, User:uploader' } }
    ActivityLog: { actor_id: 'id nullable foreign restrictOnDelete', module: 'string:50', action: 'string:50', subject_type: 'string:100 nullable', subject_id: 'unsignedBigInteger nullable', description: 'text nullable', old_values: 'json nullable', new_values: 'json nullable', ip_address: 'string:45 nullable', user_agent: 'longText nullable', correlation_id: 'uuid nullable index', indexes: [{ index: 'subject_type, subject_id' }, { index: 'actor_id, created_at' }, { index: 'module, action, created_at' }], relationships: { belongsTo: 'User:actor' } }
    RunningNumber: { plant_id: 'id foreign restrictOnDelete', department_id: 'id nullable foreign restrictOnDelete', document_type: 'string:30', period_key: 'string:12', prefix: 'string:30', digits: 'unsignedTinyInteger default:4', last_number: 'unsignedBigInteger default:0', lock_version: 'unsignedInteger default:0', is_active: 'boolean default:true index', indexes: [{ unique: 'plant_id, document_type, period_key' }, { index: 'document_type, period_key, is_active' }], relationships: { belongsTo: 'Plant, Department' } }
    GoodsRelease: { uuid: 'uuid unique', release_number: 'string:50 unique', sppb_header_id: 'id foreign cascadeOnDelete', release_sequence: unsignedInteger, is_manual: 'boolean default:false', created_by_id: 'id foreign restrictOnDelete', sender_name: 'string:255', sender_address: 'text nullable', receiver_name: 'string:255', receiver_address: 'text nullable', sender_user_id: 'id nullable foreign restrictOnDelete', receiver_user_id: 'id nullable foreign restrictOnDelete', driver_name: 'string:100 nullable', vehicle_number: 'string:50 nullable', expedition_name: 'string:100 nullable', delivery_date: 'date nullable', received_at: 'timestamp nullable', received_by_id: 'id nullable foreign restrictOnDelete', status: 'string:20 default:DRAFT index', notes: 'text nullable', verification_hash: 'char:64 unique', indexes: [{ unique: 'sppb_header_id, release_sequence' }, { index: 'status, delivery_date' }], relationships: { belongsTo: 'SppbHeader, User:createdBy, User:senderUser, User:receiverUser, User:receivedBy', hasMany: GoodsReleaseItem } }
    GoodsReleaseItem: { goods_release_id: 'id foreign cascadeOnDelete', sppb_detail_id: 'id foreign cascadeOnDelete', quantity_requested: 'decimal:18,2', quantity_released: 'decimal:18,2', quantity_received: 'decimal:18,2 default:0', condition_on_release: 'string:20 nullable', condition_on_receipt: 'string:20 nullable', is_checked: 'boolean default:false', notes: 'text nullable', indexes: [{ unique: 'goods_release_id, sppb_detail_id' }, { index: sppb_detail_id }], relationships: { belongsTo: 'GoodsRelease, SppbDetail' } }
    Notification: { user_id: 'id foreign cascadeOnDelete', notification_type: 'string:30', title: 'string:200', message: longText, url: 'string:500 nullable', is_read: 'boolean default:false index', read_at: 'timestamp nullable', indexes: [{ index: 'user_id, is_read, created_at' }, { index: notification_type }], relationships: { belongsTo: User } }
    LegacyReference: { source_system: 'string:50', source_table: 'string:100', legacy_id: 'string:100', target_type: 'string:100', target_id: unsignedBigInteger, raw_hash: 'char:64 nullable', migrated_at: timestamp, indexes: [{ unique: 'source_system, source_table, legacy_id' }, { index: 'target_type, target_id' }] }
